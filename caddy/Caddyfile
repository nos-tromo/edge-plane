# edge-plane gateway. Airgap: internal CA only — no ACME, no OCSP, no egress.
{
	admin localhost:2019
	# Container trust stores are irrelevant; operators export the root
	# via `make ca-export` instead.
	skip_install_trust
	# RFC 6066 forbids the SNI extension for literal IP addresses, so no
	# conformant client (curl, browsers, Go/OpenSSL/Python TLS stacks) ever
	# sends SNI when EDGE_HOST is an IP — without a default, every such
	# handshake fails with a TLS "internal_error" alert before HTTP is
	# even reached. Pin the one site as the SNI-less fallback.
	default_sni {$EDGE_HOST}
}

# The trusted-header model rests on this snippet: strip every identity
# header a client could smuggle in, before any routing happens.
(strip_identity) {
	request_header -X-Auth-User
	request_header -X-Auth-Email
	request_header -X-Auth-Groups
	request_header -X-Auth-Name
	request_header -Remote-User
	request_header -Remote-Groups
	request_header -Remote-Email
	request_header -Remote-Name
}

# Per-route auth: delegate to Authelia; on success rename its
# Remote-User assertion to the federation contract header X-Auth-User.
# Authorization passes through untouched (not part of the contract;
# upstreams use it internally).
(authed) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers {
			Remote-User>X-Auth-User
			Remote-Email>X-Auth-Email
			Remote-Groups>X-Auth-Groups
			Remote-Name>X-Auth-Name
		}
	}
}

http://{$EDGE_HOST}:80 {
	redir https://{$EDGE_HOST}{uri} permanent
}

https://{$EDGE_HOST}:443 {
	# EDGE_TLS selects the cert source (default: Caddy's internal CA).
	# For an org-issued certificate, set in .env:
	#   EDGE_TLS=/etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
	# and place the PEM pair in ./certs/ (bind-mounted read-only).
	tls {$EDGE_TLS:internal}
	import strip_identity

	# Vendored infra-ui design tokens (landing/tokens.css — see its header
	# for provenance): plain design-token CSS, not sensitive, so it's
	# served without auth. This also has to be a dedicated matcher rather
	# than a relative link from /auth-code/: that page's handle rewrites
	# every /auth-code/* path to index.html, so a same-prefix stylesheet
	# link would never reach a real file. An absolute /tokens.css instead
	# resolves the same way from both landing and auth-code.
	@tokens path /tokens.css
	handle @tokens {
		root * /srv/landing
		file_server
	}

	# Authelia portal + its API, served under /auth (sub-path mode).
	# Bare /auth included: Authelia's own login redirects target the
	# slash-less portal URL, which must not fall into the authenticated
	# catch-all (nested-redirect loop ending in a 404 after login).
	@auth path /auth /auth/*
	handle @auth {
		reverse_proxy authelia:9091
	}

	# App routes: prefix is NOT stripped — each upstream serves under
	# its sub-path (SPA base / serve_from_sub_path; delivery steps ②–④).
	# Each matcher covers the bare prefix too (/chorus as well as
	# /chorus/*): handle's path matcher alone misses the slash-less
	# form, which would 404 at the gateway before reaching the app.
	@chorus path /chorus /chorus/*
	handle @chorus {
		import authed
		reverse_proxy chorus-frontend:8080
	}
	@docint path /docint /docint/*
	handle @docint {
		import authed
		reverse_proxy docint-frontend:8080
	}
	@nextext path /nextext /nextext/*
	handle @nextext {
		import authed
		reverse_proxy nextext-frontend:8080
	}
	@translator path /translator /translator/*
	handle @translator {
		import authed
		reverse_proxy translator-frontend:8080
	}
	# Open WebUI has no sub-path support (its SvelteKit frontend bakes
	# root-absolute asset paths, e.g. /_app/..., at image build time —
	# there is no runtime base-path env to rewrite them). It gets a
	# dedicated port (see the :8443 site block below) instead of living
	# under this path; redirect anyone who types /webui there.
	@webui path /webui /webui/*
	handle @webui {
		# No forward_auth here — Caddy orders redir before forward_auth,
		# so a check in this block can never run. Auth is enforced at the
		# destination: the :8443 site gates every request.
		redir https://{$EDGE_HOST}:8443
	}
	@grafana path /grafana /grafana/*
	handle @grafana {
		import authed
		reverse_proxy grafana:3000
	}

	# One-time-code viewer (design doc §2): authed users read the code
	# Authelia "mailed" to the notify volume; the template shows it only
	# when Recipient matches X-Auth-Email. The rewrite pins every path to
	# the template, so the raw notification file is never served.
	@authcode path /auth-code /auth-code/*
	handle @authcode {
		import authed
		root * /srv/authcode
		rewrite * /index.html
		templates
		file_server
	}

	# Dev-only extra routes land here via the compose override
	# (production ships only empty.caddy in this directory).
	import /etc/caddy/conf.d/*.caddy

	# Landing page (authenticated) for everything else. `templates`
	# renders the signed-in identity (X-Auth-User, injected by authed)
	# into the static HTML server-side.
	handle {
		import authed
		root * /srv/landing
		templates
		file_server
	}
}

# Open WebUI has no sub-path support (root-absolute assets); it gets a
# dedicated port instead of a /webui path, same auth + headers.
https://{$EDGE_HOST}:8443 {
	tls {$EDGE_TLS:internal}
	import strip_identity

	# The proxy must live inside a handle block: at site level Caddy
	# orders forward_auth BEFORE request_header, so strip_identity would
	# delete the X-Auth-* headers copy_headers just injected. handle
	# sorts after request_header, restoring strip -> auth -> inject.
	handle {
		import authed
		reverse_proxy open-webui:8080 {
			# Cap long-lived streams (socket.io): forward_auth only
			# gates the HTTP upgrade, so an open WebSocket would
			# otherwise outlive the Authelia session indefinitely.
			# Re-upgrades pass back through forward_auth.
			stream_timeout 30m
		}
	}
}
