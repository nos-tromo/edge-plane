# edge-plane gateway. Airgap: internal CA only — no ACME, no OCSP, no egress.
{
	admin localhost:2019
	# Container trust stores are irrelevant; operators export the root
	# via `make ca-export` instead.
	skip_install_trust
	# RFC 6066 forbids the SNI extension for literal IP addresses, so no
	# conformant client (curl, browsers, Go/OpenSSL/Python TLS stacks) ever
	# sends SNI when EDGE_HOST is an IP — without a default, every such
	# handshake fails with a TLS "internal_error" alert before HTTP is
	# even reached. Pin the one site as the SNI-less fallback.
	default_sni {$EDGE_HOST}
}

# The trusted-header model rests on this snippet: strip every identity
# header a client could smuggle in, before any routing happens. That
# includes X-Edge-Secret, which only the gateway may set (see the app routes).
(strip_identity) {
	request_header -X-Edge-Secret
	request_header -X-Auth-User
	request_header -X-Auth-Email
	request_header -X-Auth-Groups
	request_header -X-Auth-Name
	request_header -Remote-User
	request_header -Remote-Groups
	request_header -Remote-Email
	request_header -Remote-Name
}

# Per-route auth: delegate to Authelia; on success rename its
# Remote-User assertion to the federation contract header X-Auth-User.
# Authorization passes through untouched (not part of the contract;
# upstreams use it internally).
(authed) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers {
			Remote-User>X-Auth-User
			Remote-Email>X-Auth-Email
			Remote-Groups>X-Auth-Groups
			Remote-Name>X-Auth-Name
		}
	}
}

# Access log: one JSON line per request with the authenticated account
# (`user`) and Caddy's request id (`uuid`, the value the app upstreams
# receive as X-Request-ID). The query string is cut from the URI and
# request/response headers are dropped (they carry referers, cookies and
# the identity headers), so the line holds who, what path, when, from where
# and with what result, never request content.
(access_log) {
	log {
		output stdout
		format filter {
			request>uri regexp `\?.*$` "?<redacted>"
			request>headers delete
			resp_headers delete
		}
	}
	log_append user {http.request.header.X-Auth-User}
}

http://{$EDGE_HOST}:80 {
	redir https://{$EDGE_HOST}{uri} permanent
}

https://{$EDGE_HOST}:443 {
	# EDGE_TLS selects the cert source (default: Caddy's internal CA).
	# For an org-issued certificate, set in .env:
	#   EDGE_TLS=/etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
	# and place the PEM pair in ./certs/ (bind-mounted read-only).
	tls {$EDGE_TLS:internal}
	import strip_identity
	import access_log

	# Vendored infra-ui design tokens (landing/tokens.css — see its header
	# for provenance): plain design-token CSS, not sensitive, so it's
	# served without auth. This also has to be a dedicated matcher rather
	# than a relative link from /auth-code/: that page's handle rewrites
	# every /auth-code/* path to index.html, so a same-prefix stylesheet
	# link would never reach a real file. An absolute /tokens.css instead
	# resolves the same way from both landing and auth-code.
	@tokens path /tokens.css
	handle @tokens {
		root * /srv/landing
		file_server
	}

	# The portal's favicon set (landing/favicon.*, apple-touch-icon.png),
	# linked absolutely by every portal page. Served without auth like
	# tokens.css: the information pages link it before any session exists,
	# browsers ask for /favicon.ico on their own (the login page included),
	# and the files say nothing about anyone.
	@brand path /favicon.ico /favicon.svg /favicon-32.png /apple-touch-icon.png
	handle @brand {
		root * /srv/landing
		file_server
	}

	# Authelia portal + its API, served under /auth (sub-path mode).
	# Bare /auth included: Authelia's own login redirects target the
	# slash-less portal URL, which must not fall into the authenticated
	# catch-all (nested-redirect loop ending in a 404 after login).
	@auth path /auth /auth/*
	handle @auth {
		reverse_proxy authelia:9091
	}

	# Every app upstream gets two headers. X-Edge-Secret carries that app's
	# own secret (from .env): its backend trusts X-Auth-* only when the
	# secret matches, because the backends sit on shared networks where any
	# container could otherwise send forged identity headers. Per-app values
	# keep one app from impersonating users towards another. The quotes make
	# an unset secret an empty header, which an app without its own secret
	# ignores. X-Request-ID is the id this gateway also logs (`uuid` in
	# access_log), so its line can be matched with the app's records. Grafana gets neither:
	# it cannot check a secret and is reachable on edge-net only.
	#
	# App routes: prefix is NOT stripped — each upstream serves under
	# its sub-path (SPA base / serve_from_sub_path; delivery steps ②–④).
	# Each matcher covers the bare prefix too (/docint as well as
	# /docint/*): handle's path matcher alone misses the slash-less
	# form, which would 404 at the gateway before reaching the app.
	@docint path /docint /docint/*
	handle @docint {
		import authed
		reverse_proxy docint-frontend:8080 {
			header_up X-Edge-Secret "{$DOCINT_EDGE_SECRET}"
			header_up X-Request-ID {http.request.uuid}
		}
	}
	@nextext path /nextext /nextext/*
	handle @nextext {
		import authed
		reverse_proxy nextext-frontend:8080 {
			header_up X-Edge-Secret "{$NEXTEXT_EDGE_SECRET}"
			header_up X-Request-ID {http.request.uuid}
		}
	}
	@translator path /translator /translator/*
	handle @translator {
		import authed
		reverse_proxy translator-frontend:8080 {
			header_up X-Edge-Secret "{$TRANSLATOR_EDGE_SECRET}"
			header_up X-Request-ID {http.request.uuid}
		}
	}
	# SSE answers and silent tool turns: no flush_interval (Caddy flushes an
	# event stream at once) and no stream_timeout (it caps streaming requests
	# such as WebSockets); the backend's wall time bounds a turn.
	@ghostwriter path /ghostwriter /ghostwriter/*
	handle @ghostwriter {
		import authed
		reverse_proxy ghostwriter-frontend:8080 {
			header_up X-Edge-Secret "{$GHOSTWRITER_EDGE_SECRET}"
			header_up X-Request-ID {http.request.uuid}
		}
	}
	# obs-plane's two Grafanas share edge-net with every app frontend, so a
	# guard in front of each checks its own edge secret like the apps do.
	@grafana path /grafana /grafana/*
	handle @grafana {
		import authed
		reverse_proxy grafana:3000 {
			header_up X-Edge-Secret "{$GRAFANA_EDGE_SECRET}"
			header_up X-Request-ID {http.request.uuid}
		}
	}
	# Audit-trail viewer (obs-plane's grafana-audit): the `audit` group only
	# (authelia/configuration.yml), deliberately not `admins`. Its guard
	# refuses every request without AUDIT_EDGE_SECRET, so this route answers
	# 403 until both .env files carry the same value. Requests here are
	# themselves in the access log, i.e. reading the audit trail is audited.
	@audit path /audit /audit/*
	handle @audit {
		import authed
		reverse_proxy grafana-audit:3000 {
			header_up X-Edge-Secret "{$AUDIT_EDGE_SECRET}"
			header_up X-Request-ID {http.request.uuid}
		}
	}

	# One-time-code viewer (design doc §2): authed users read the code
	# Authelia "mailed" to the notify volume; the template shows it only
	# when Recipient matches X-Auth-Email. The rewrite pins every path to
	# the template, so the raw notification file is never served.
	@authcode path /auth-code /auth-code/*
	handle @authcode {
		import authed
		root * /srv/authcode
		rewrite * /index.html
		templates
		file_server
	}

	# Information pages (docs/configuration.md#portal-information-pages):
	# the operator's Markdown in info/, e.g. the privacy notice the Authelia
	# login page links to. Deliberately unauthenticated, since that notice is
	# due before the login collects anything. The rewrite pins every path to
	# the template, whose file functions read /srv/portal/info only; it shows
	# no identity and answers 404 to any name other than lowercase letters,
	# digits and hyphens, so the *.example.md templates never render.
	@info path /info/*
	handle @info {
		root * /srv/landing
		rewrite * /info.html
		templates {
			root /srv/portal/info
		}
		file_server
	}

	# Dev-only extra routes land here via the compose override
	# (production ships only empty.caddy in this directory).
	import /etc/caddy/conf.d/*.caddy

	# Landing page (authenticated) for everything else. `templates`
	# renders the signed-in identity (X-Auth-User, injected by authed)
	# into the static HTML server-side. Its file functions read from
	# /srv/portal only (announcements/ and info/, both Markdown): nothing
	# else in the container, such as the CA key on /data, is reachable
	# through EDGE_ANNOUNCEMENT_FILE, and the .md files are never served
	# directly.
	handle {
		import authed
		root * /srv/landing
		templates {
			root /srv/portal
		}
		file_server
	}
}
