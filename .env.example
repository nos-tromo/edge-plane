# Copy to .env and adjust per host. NEVER commit .env.
EDGE_HOST=127.0.0.1            # LAN hostname or IP users type into the browser. Authelia rejects
                               # dot-less names like `localhost` (RFC 6265 cookie-domain rule);
                               # use a dotted hostname or an IP.
EDGE_NET=edge-net
# Generate real secrets with: make secret
AUTHELIA_SESSION_SECRET=insecure-dev-session-secret-0123456789abcdef
AUTHELIA_STORAGE_ENCRYPTION_KEY=insecure-dev-storage-key-0123456789abcdef
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=insecure-dev-jwt-secret-0123456789abcdef

# Per-app edge secrets (docs/identity-contract.md#edge-secret). The gateway
# sends each to its app as X-Edge-Secret, and the app trusts the X-Auth-*
# identity headers only when it matches the same variable in the app's own
# .env (CHORUS_EDGE_SECRET in chorus/.env, and so on). Generate each with
# `make secret`. Empty sends an empty header, which an app without its own
# secret ignores.
CHORUS_EDGE_SECRET=
DOCINT_EDGE_SECRET=
NEXTEXT_EDGE_SECRET=
TRANSLATOR_EDGE_SECRET=
OPEN_WEBUI_EDGE_SECRET=
# obs-plane's two Grafanas (same names in obs-plane's .env). The audit-trail
# viewer refuses every request until AUDIT_EDGE_SECRET is set on both sides.
GRAFANA_EDGE_SECRET=
AUDIT_EDGE_SECRET=

# Login policy for every protected route: two_factor (default; password +
# TOTP) or one_factor. `make up-dev` uses one_factor. TOTP is provisioned by
# an admin (`make totp U=<user>`) — do that for every user before running
# with two_factor (docs/user-accounts.md#second-factor).
# EDGE_AUTH_POLICY=two_factor

# TLS cert source. Unset -> Caddy's internal CA (default; see
# docs/tls-runbook.md). For an org-issued certificate placed in certs/, set:
# EDGE_TLS=/etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

# Landing-page UI language. Unset -> en. Set to de for a German landing page
# (the Authelia login portal localizes itself from the browser instead).
# RESPONSE_LANGUAGE=de

# Support contact shown on the portal's "report a problem" tile (e.g. an
# email address or room/phone). Unset -> tile is hidden.
# EDGE_SUPPORT_CONTACT=admin@example.invalid

# Session lifetimes. Unset -> 12h expiration, 4h inactivity timeout, 2M
# remember-me (authelia/configuration.yml). Authelia duration syntax:
# 30m, 12h, 1w, 2M, 1y.
# EDGE_SESSION_EXPIRATION=12h
# EDGE_SESSION_INACTIVITY=4h
# EDGE_SESSION_REMEMBER_ME=2M

# Proxy bypass: NO_PROXY/no_proxy are set in docker/compose.yaml with the
# edge-net upstream aliases and private ranges. To exempt additional
# hostnames, set EXTRA_NO_PROXY below (must start with a leading comma):
# EXTRA_NO_PROXY=,some-extra-host
