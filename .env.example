# Copy to .env and adjust per host. NEVER commit .env.
EDGE_HOST=127.0.0.1            # LAN hostname or IP users type into the browser. Authelia rejects
                               # dot-less names like `localhost` (RFC 6265 cookie-domain rule);
                               # use a dotted hostname or an IP.
EDGE_NET=edge-net
# Generate real secrets with: docker compose run --rm authelia authelia crypto rand --length 64
AUTHELIA_SESSION_SECRET=insecure-dev-session-secret-0123456789abcdef
AUTHELIA_STORAGE_ENCRYPTION_KEY=insecure-dev-storage-key-0123456789abcdef
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=insecure-dev-jwt-secret-0123456789abcdef
