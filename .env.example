# edge-plane — example configuration
#
# deploy's `make env` writes .env from this file and keeps it in step
# (by hand: cp .env.example .env).
#
#   KEY=value     set per host
#   # KEY=value   optional; the value shown is the default
#
# Tags, on the line above a setting:
#   [required]          must be set on every host
#   [secret]            never printed; your value never follows the example
#   [shared: M [KEY]]   same value as member M (its KEY); make env fills it
#   [dev]               read only by the dev overlay (make up-dev)

# =============================================================================
# Required
# =============================================================================

# The LAN hostname or IP users type into the browser. Authelia rejects
# dot-less names like `localhost` (RFC 6265 cookie-domain rule); use a dotted
# hostname or an IP (docs/tls-runbook.md). obs-plane and open-webui-service
# take the same value; make env fills them.
# [required] [shared: obs-plane, open-webui-service]
EDGE_HOST=

# Authelia's three secrets. Generate each with `make secret`. Set them before
# the first `make up`: the storage key encrypts Authelia's database on first
# start (docs/user-accounts.md).
# [required] [secret]
AUTHELIA_SESSION_SECRET=
# [required] [secret]
AUTHELIA_STORAGE_ENCRYPTION_KEY=
# [required] [secret]
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=

# The edge secret for obs-plane's audit-trail viewer, sent as X-Edge-Secret;
# the viewer answers 403 to every request without it. Same value as
# AUDIT_EDGE_SECRET in obs-plane's .env; at least 32 characters. Generate it
# with `make secret`.
# [required] [secret] [shared: obs-plane]
AUDIT_EDGE_SECRET=

# =============================================================================
# Auth & identity
# =============================================================================

# Per-app edge secrets (docs/identity-contract.md#edge-secret). The gateway
# sends each to its app as X-Edge-Secret, and the app trusts the X-Auth-*
# identity headers only when it matches the same variable in the app's own
# .env (DOCINT_EDGE_SECRET in docint/.env, and so on). Generate each with
# `make secret`. Unset sends an empty header, which an app without its own
# secret ignores. The default is empty.
# [secret] [shared: docint]
# DOCINT_EDGE_SECRET=
# [secret] [shared: Nextext]
# NEXTEXT_EDGE_SECRET=
# [secret] [shared: translator]
# TRANSLATOR_EDGE_SECRET=
# [secret] [shared: open-webui-service]
# OPEN_WEBUI_EDGE_SECRET=

# The same for obs-plane's Grafana (/grafana), same name in obs-plane's .env.
# The default is empty: obs-plane then trusts the identity headers from any
# caller on edge-net.
# [secret] [shared: obs-plane]
# GRAFANA_EDGE_SECRET=

# Login policy for every protected route: two_factor (password + TOTP) or
# one_factor. `make up-dev` uses one_factor. TOTP is provisioned by an admin
# (`make totp U=<user>`) -- do that for every user before running with
# two_factor (docs/user-accounts.md#second-factor).
# EDGE_AUTH_POLICY=two_factor

# Session lifetimes, in Authelia duration syntax: 30m, 12h, 1w, 2M, 1y
# (authelia/configuration.yml).
# EDGE_SESSION_EXPIRATION=12h
# EDGE_SESSION_INACTIVITY=4h
# EDGE_SESSION_REMEMBER_ME=2M

# =============================================================================
# Network & proxy
# =============================================================================

# Name of the external network between the gateway and the app frontends.
# Created via `make network`. Override only if you renamed it.
# EDGE_NET=edge-net

# TLS cert source. The default is Caddy's internal CA (docs/tls-runbook.md).
# For an org-issued certificate placed in certs/, set the certificate and the
# key, separated by a blank:
#   EDGE_TLS=/etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
# EDGE_TLS=internal

# Proxy bypass: NO_PROXY/no_proxy are set in docker/compose.yaml with the
# edge-net upstream aliases and private ranges. To exempt more hostnames, set
# this list; it must start with a leading comma, e.g. `,some-extra-host`.
# EXTRA_NO_PROXY=

# =============================================================================
# edge-plane
# =============================================================================

# Landing-page UI language: en, or de for a German landing page (the Authelia
# login portal localizes itself from the browser instead).
# RESPONSE_LANGUAGE=en

# Support contact shown on the portal's "report a problem" tile (an email
# address or room/phone). Empty hides the tile.
# EDGE_SUPPORT_CONTACT=

# =============================================================================
# Audit & retention
# =============================================================================

# Audit events (docs/audit.md): seconds between auth-audit's rounds over
# Authelia's authentication log and authelia/users.yml.
# AUDIT_POLL_INTERVAL=5
